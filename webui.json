{
  "schema_version": 2,
  "required_capabilities": ["custom_pages"],
  "workspace_title": "歌词曲库",
  "pages": [
    {
      "id": "lyrics",
      "title": "歌词曲库",
      "description": "曲库规模与歌词覆盖率、检索、缺歌词清单、最近命中，以及同步/补歌词后台任务的触发与进度。",
      "icon": "database",
      "mode": "custom",
      "entry": "webui/lyrics.html",
      "layout": "document",
      "queries": {
        "stats": {
          "api": "lyrics.stats",
          "version": "1",
          "parameters": {}
        },
        "task": {
          "api": "lyrics.task",
          "version": "1",
          "parameters": {}
        },
        "search": {
          "api": "lyrics.search",
          "version": "1",
          "parameters": {
            "keyword": { "type": "string", "max_length": 60 },
            "scope": { "type": "string", "max_length": 16 },
            "limit": { "type": "string", "max_length": 8 }
          }
        },
        "empty": {
          "api": "lyrics.empty",
          "version": "1",
          "parameters": {
            "limit": { "type": "string", "max_length": 8 },
            "skip_days": { "type": "string", "max_length": 8 }
          }
        },
        "recent": {
          "api": "lyrics.recent",
          "version": "1",
          "parameters": {
            "limit": { "type": "string", "max_length": 8 }
          }
        },
        "song": {
          "api": "lyrics.song",
          "version": "1",
          "parameters": {
            "name": { "type": "string", "max_length": 80 }
          }
        }
      },
      "actions": {
        "start_sync": {
          "api": "lyrics.start_sync",
          "version": "1",
          "parameters": {
            "limit": { "type": "string", "max_length": 8 }
          }
        },
        "start_refetch": {
          "api": "lyrics.start_refetch",
          "version": "1",
          "parameters": {
            "limit": { "type": "string", "max_length": 8 }
          }
        },
        "cancel": {
          "api": "lyrics.cancel",
          "version": "1",
          "parameters": {},
          "confirmation": "确认取消正在跑的后台任务？已抓取的部分会保留入库。"
        }
      }
    }
  ]
}