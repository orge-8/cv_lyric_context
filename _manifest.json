{
    "manifest_version": 2,
    "id": "org.mai-mai.cv-lyric-context",
    "version": "2.4.1",
    "name": "中V歌词识别 · 歌曲库",
    "description": "入站消息命中中文VOCALOID歌词时，通过 maisaka.replyer.before_model_request Hook 向 LLM 上下文注入歌曲名/歌手/P主，让 bot 能自然接住歌词话题。内置 3412 首中V词库；可丢 .txt/.lrc 歌词文件进收件箱扩充，也能从 VCPedia 同步 4000+ 首歌曲（含作词作曲等完整信息）并用「/歌词」系列命令或聊天直接查询。",
    "author": {
        "name": "orge-8",
        "url": "https://github.com/orge-8"
    },
    "urls": {
        "repository": "https://github.com/orge-8/cv_lyric_context",
        "homepage": "https://github.com/orge-8/cv_lyric_context",
        "issues": "https://github.com/orge-8/cv_lyric_context/issues"
    },
    "license": "MIT",
    "host_application": {
        "min_version": "1.0.0",
        "max_version": "1.99.99"
    },
    "sdk": {
        "min_version": "2.0.0",
        "max_version": "2.99.99"
    },
    "capabilities": [
        "send.text"
    ],
    "i18n": {
        "default_locale": "zh-CN"
    }
}
